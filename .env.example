# ============================================================
# .env.example — Copia este archivo a .env y rellena tus datos
# NO subas el archivo .env a GitHub ni lo compartas
# ============================================================

#===============================
# === GITHUB AUTO-UPDATE ===
#===============================
# Repositorio para actualizaciones automáticas (formato: usuario/repo)
# Ejemplo: GITHUB_REPO=tuusuario/TelBot
GITHUB_REPO=truji57/TelBot
# Rama a seguir (normalmente "main")
GITHUB_BRANCH=master
#===============================

#===============================
# === TELEGRAM API ===
#===============================
# Obtener en: https://my.telegram.org → API development tools
TELEGRAM_API_ID=TU_API_ID_AQUI
TELEGRAM_API_HASH=TU_API_HASH_AQUI
TELEGRAM_PHONE=+34600000000
#===============================

#===============================
#   ===   CANAL DE SEÑALES  ===
#===============================
# Si el canal tiene username público: @nombre_canal
# Si es privado: ID numérico negativo (ej: -1001234567890)
SIGNAL_CHANNEL=@nombre_del_canal
#===============================

#===============================
# === CHAT DE REENVIO DE SEÑALES ===
#===============================
# ID del chat/grupo/canal donde se reenvian las señales parseadas.
# Puede ser el username (@grupo) o el ID numérico (ej: -1001234567890).
FORWARD_CHAT_ID=TU_CHAT_ID_AQUI
#===============================

#===============================
# === CHAT DE CONTROL (COMANDOS) ===
#===============================
# ID del chat/grupo desde donde enviar comandos al bot (/help, /status, ...).
# Opcional: si no se configura, los comandos no estarán disponibles.
CONTROL_CHAT_ID=TU_CHAT_ID_DE_CONTROL
#===============================

#===============================
# === METATRADER 5 ===
#===============================
MT5_LOGIN=TU_NUMERO_DE_CUENTA
MT5_PASSWORD=TU_PASSWORD_MT5
MT5_SERVER=NombreBroker-Demo
# Ruta al ejecutable de MetaTrader 5 (puede haber varias instancias)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Identificador opcional de la instancia (útil si se ejecutan múltiples terminales)
MT5_INSTANCE_ID=default
#===============================

#===============================
# === GESTIÓN DE RIESGO ===
#===============================
# Porcentaje del balance a arriesgar por operación
RISK_PERCENT=1.0
# Límites de tamaño de lote
MAX_LOT_SIZE=1.0
MIN_LOT_SIZE=0.01
# Número mágico para identificar órdenes del bot en MT5
# Déjalo vacío para no usar magic number
DEFAULT_MAGIC=20240101
# Comentario personalizado para las órdenes (opcional, vacío = sin comentario)
ORDER_COMMENT=
# Random offset en ticks para evitar detección de group trading.
# Aplica un desplazamiento aleatorio a entry, SL y TP (0 = desactivado).
# Ejemplo: 3 = entre -3 y +3 ticks aleatorios por operación
RANDOM_OFFSET_TICKS=0
#===============================

#===============================
# === MODO PRUEBA ===
#===============================
# true = parsea señales pero NO ejecuta órdenes en MT5
# false = modo producción real
DRY_RUN=true
#===============================

#===============================
# === CONFIRMACIÓN DE TRADES ===
#===============================
# true = pide confirmación del usuario antes de colocar la orden (botón Sí/No)
# false = ejecuta automáticamente sin confirmación
CONFIRM_TRADES=false
#===============================

# Configuración de reintentos al enviar órdenes a MT5
# Reintenta si el error es transitorio (precio inválido, timeout, etc.)
# 0 = desactivado
ORDER_RETRY_COUNT=3
# Segundos de espera entre reintentos
ORDER_RETRY_DELAY=1.0
# Elegir qué TP usar: 0 = último TP (por defecto), 1 = TP1, 2 = TP2, 3 = TP3
TP_INDEX=0
# Ratio riesgo/beneficio personalizado (0 = desactivado, usa los TP de la señal)
# Ejemplo: 1.0 = RR 1:1, 2.0 = RR 1:2. Ignora los TP de la señal
RR_RATIO=0
#===============================

# Configuración del polling de mensajes perdidos
POLLING_INTERVAL=15
MESSAGE_LIMIT=20
